{
  "type": "module",
  "name": "parcial-1-api-rest-2026",
  "version": "1.0.0",
  "description": "API REST de gestión de tareas: Parcial 1 de Desarrollo Web 2026",
  "main": "dist/app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.ts",
    "start": "npm run build:ts && node --env-file=.env dist/server.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test": "npm run typecheck && node --test --test-concurrency=1 test/*.test.ts",
    "test:db": "npm run build:ts && node --env-file=.env --test --test-concurrency=1 test/integration/database.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.23.0",
    "pkg-up": "^3.1.0",
    "typebox": "^1.3.30",
    "@fastify/error": "^4.2.0",
    "@fastify/cors": "^11.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/pg": "^8.23.1",
    "c8": "^11.0.0",
    "concurrently": "^9.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
