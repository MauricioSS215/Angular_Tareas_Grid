# Copiar a .env y completar con la conexión PostgreSQL local.
FASTIFY_PORT=3000
FASTIFY_HOST=127.0.0.1
FASTIFY_LOG_LEVEL=info
FASTIFY_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu_clave_postgres
PGDATABASE=Parcial2026Tareas

# Orígenes permitidos para el futuro frontend Angular.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Opcional: usar una conexión diferente para npm run test:db.
# TEST_DATABASE_URL=postgresql://usuario:clave@localhost:5432/base_de_pruebas
