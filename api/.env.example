# Copiar a .env y completar con la conexión PostgreSQL local.
FASTIFY_PORT=3000
FASTIFY_HOST=127.0.0.1
FASTIFY_LOG_LEVEL=info
FASTIFY_SECRET=

PGHOST=localhost
# Si 5432 está ocupado, usar otro puerto libre, por ejemplo 5434.
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=Parcial2026Tareas

# Orígenes permitidos por la API.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
